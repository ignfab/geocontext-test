# Copy to .env and fill in what you need: cp .env.sample .env
# Variables already set in the environment take precedence over this file.

# Model under test (default: anthropic:claude-haiku-4-5)
#MODEL_NAME=anthropic:claude-haiku-4-5

# API keys, only the one matching MODEL_NAME is required
ANTHROPIC_API_KEY=
#GOOGLE_API_KEY=
#MISTRAL_API_KEY=
#ONYXIA_API_KEY=
#ALBERT_API_KEY=

# MCP servers config (default: config/mcp-servers.json, geocontext via npx)
#MCP_SERVERS_PATH=config/mcp-servers.json

# geocontext over HTTP (https://geollm.beta.ign.fr/geocontext/mcp).
# For another URL, copy this file, edit its "url" and point to the copy.
#MCP_SERVERS_PATH=config/mcp-servers-http.json

# Proxy, also passed to the MCP server
#HTTP_PROXY=http://proxy-host:port
#HTTPS_PROXY=http://proxy-host:port
#NO_PROXY=localhost,127.0.0.1
